{
  "name": "opensurvey-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "OpenSurvey React islands (survey builder + public runtime) built with Vite, mounted into Django via django-vite. PLAN.md §8.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build:widget",
    "build:islands": "vite build",
    "build:widget": "vite build --config vite.widget.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "dompurify": "^3.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^1.6.0"
  }
}
