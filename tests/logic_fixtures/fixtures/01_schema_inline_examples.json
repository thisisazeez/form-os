  {
    "name": "schema example 2 — detractor (NPS<=6) jumps to reason",
    "description": "survey-schema.json examples[1]. NPS 3 is a detractor -> rule r1 fires -> jumpTo reason.",
    "survey": {
      "name": "Post-purchase feedback",
      "status": "published",
      "languages": [
        { "code": "en", "label": "English", "default": true },
        { "code": "es", "label": "Español", "default": false }
      ],
      "questions": [
        {
          "id": "nps",
          "type": "nps",
          "required": true,
          "headline": { "default": "How likely are you to recommend us?", "en": "How likely are you to recommend us?", "es": "¿Qué tan probable es que nos recomiende?" },
          "config": {},
          "logic": [
            {
              "id": "r1",
              "condition": { "leftQuestionId": "nps", "operator": "lessThanOrEqual", "value": 6 },
              "action": { "type": "jumpTo", "target": "reason" }
            }
          ]
        },
        {
          "id": "rating",
          "type": "rating",
          "required": false,
          "headline": { "default": "How was the checkout experience?", "en": "How was the checkout experience?", "es": "¿Cómo fue la experiencia de pago?" },
          "config": { "range": 5, "scale": "star" },
          "logic": [
            {
              "id": "r2",
              "condition": { "leftQuestionId": "rating", "operator": "isSubmitted" },
              "action": { "type": "jumpTo", "target": "end1" }
            }
          ]
        },
        {
          "id": "reason",
          "type": "openText",
          "required": false,
          "headline": { "default": "What could we do better?", "en": "What could we do better?", "es": "¿Qué podríamos mejorar?" },
          "config": { "inputType": "long", "maxLength": 2000 },
          "logic": []
        }
      ],
      "endings": [{ "id": "end1", "type": "endScreen", "headline": { "default": "Thanks for your feedback!", "en": "Thanks for your feedback!", "es": "¡Gracias por sus comentarios!" } }]
    },
    "answers": { "nps": 3 },
    "currentQuestionId": "nps",
    "expected_next": { "type": "question", "id": "reason" }
  },

