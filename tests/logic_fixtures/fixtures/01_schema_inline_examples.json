  {
    "name": "schema example 3 — singleSelect 'no' skips email",
    "description": "survey-schema.json examples[2]. 'no' -> g1 skip(email) fires first -> advance past email -> end -> first ending.",
    "survey": {
      "name": "Feature interest",
      "status": "draft",
      "languages": [{ "code": "en", "label": "English", "default": true }],
      "questions": [
        {
          "id": "interested",
          "type": "singleSelect",
          "required": true,
          "headline": { "default": "Are you interested in a demo?" },
          "config": {
            "choices": [
              { "id": "yes", "label": { "default": "Yes" } },
              { "id": "no", "label": { "default": "No" } }
            ]
          },
          "logic": [
            {
              "id": "g1",
              "condition": { "leftQuestionId": "interested", "operator": "equals", "value": "no" },
              "action": { "type": "skip", "target": "email" }
            },
            {
              "id": "g2",
              "condition": { "leftQuestionId": "interested", "operator": "equals", "value": "yes" },
              "action": { "type": "require", "target": "email" }
            }
          ]
        },
        {
          "id": "email",
          "type": "contactInfo",
          "required": false,
          "headline": { "default": "Where should we reach you?" },
          "config": { "fields": { "email": { "show": true, "required": true } } },
          "logic": []
        }
      ],
      "endings": [{ "id": "end1", "type": "endScreen", "headline": { "default": "Thanks!" } }]
    },
    "answers": { "interested": "no" },
    "currentQuestionId": "interested",
    "expected_next": { "type": "ending", "id": "end1" },
    "expected_required": ["interested"]
  },

  {
    "name": "schema example 3 — singleSelect 'yes' requires email and advances to it",
    "description": "'yes' -> g1 (skip) condition false, g2 (require email) fires but is NOT navigation -> linear next is email; email is required-by-logic.",
    "survey": {
      "name": "Feature interest",
      "status": "draft",
      "languages": [{ "code": "en", "label": "English", "default": true }],
      "questions": [
        {
          "id": "interested",
          "type": "singleSelect",
          "required": true,
          "headline": { "default": "Are you interested in a demo?" },
          "config": {
            "choices": [
              { "id": "yes", "label": { "default": "Yes" } },
              { "id": "no", "label": { "default": "No" } }
            ]
          },
          "logic": [
            {
              "id": "g1",
              "condition": { "leftQuestionId": "interested", "operator": "equals", "value": "no" },
              "action": { "type": "skip", "target": "email" }
            },
            {
              "id": "g2",
              "condition": { "leftQuestionId": "interested", "operator": "equals", "value": "yes" },
              "action": { "type": "require", "target": "email" }
            }
          ]
        },
        {
          "id": "email",
          "type": "contactInfo",
          "required": false,
          "headline": { "default": "Where should we reach you?" },
          "config": { "fields": { "email": { "show": true, "required": true } } },
          "logic": []
        }
      ],
      "endings": [{ "id": "end1", "type": "endScreen", "headline": { "default": "Thanks!" } }]
    },
    "answers": { "interested": "yes" },
    "currentQuestionId": "interested",
    "expected_next": { "type": "question", "id": "email" },
    "expected_required": ["interested", "email"]
