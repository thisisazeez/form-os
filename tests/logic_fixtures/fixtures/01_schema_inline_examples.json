  {
    "name": "schema example 1 — single-question NPS, answered, end of survey -> first ending",
    "description": "survey-schema.json examples[0]. One required NPS question, one ending. Answering it falls off the end -> first ending.",
    "survey": {
      "name": "Product NPS",
      "status": "published",
      "languages": [{ "code": "en", "label": "English", "default": true }],
      "styling": { "brandColor": "#0F62FE", "hideProgressBar": true },
      "questions": [
        {
          "id": "nps1",
          "type": "nps",
          "required": true,
          "headline": { "default": "How likely are you to recommend us?", "en": "How likely are you to recommend us?" },
          "config": {
            "lowerLabel": { "default": "Not at all likely", "en": "Not at all likely" },
            "upperLabel": { "default": "Extremely likely", "en": "Extremely likely" }
          },
          "logic": []
        }
      ],
      "endings": [{ "id": "end1", "type": "endScreen", "headline": { "default": "Thank you!", "en": "Thank you!" } }]
    },
    "answers": { "nps1": 9 },
    "currentQuestionId": "nps1",
    "expected_next": { "type": "ending", "id": "end1" },
    "expected_required": ["nps1"]
  },

