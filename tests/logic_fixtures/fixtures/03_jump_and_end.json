      "languages": [{ "code": "en", "label": "English", "default": true }],
      "questions": [
        {
          "id": "q1",
          "type": "number",
          "headline": { "default": "Age?" },
          "config": {},
          "logic": [
            { "id": "e1", "condition": { "leftQuestionId": "q1", "operator": "lessThan", "value": 18 }, "action": { "type": "endSurvey" } }
          ]
        },
        { "id": "q2", "type": "openText", "headline": { "default": "q2" }, "config": { "inputType": "short" }, "logic": [] }
