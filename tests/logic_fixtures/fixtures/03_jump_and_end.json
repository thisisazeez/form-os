      "endings": [
        { "id": "first_ending", "type": "endScreen", "headline": { "default": "Thank you" } },
        { "id": "second_ending", "type": "endScreen", "headline": { "default": "Other" } }
      ]
    },
    "answers": { "q1": 15 },
    "currentQuestionId": "q1",
    "expected_next": { "type": "ending", "id": "first_ending" }
