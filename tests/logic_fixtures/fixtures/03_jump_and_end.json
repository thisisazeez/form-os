  {
    "name": "first matching rule wins — earlier rule short-circuits a later one",
    "description": "Both r1 (jumpTo q3) and r2 (jumpTo q4) would match; r1 is first in array order -> q3.",
    "survey": {
      "languages": [{ "code": "en", "label": "English", "default": true }],
      "questions": [
        {
          "id": "q1",
          "type": "number",
          "headline": { "default": "Score?" },
          "config": {},
          "logic": [
            { "id": "r1", "condition": { "leftQuestionId": "q1", "operator": "greaterThan", "value": 5 }, "action": { "type": "jumpTo", "target": "q3" } },
            { "id": "r2", "condition": { "leftQuestionId": "q1", "operator": "greaterThan", "value": 3 }, "action": { "type": "jumpTo", "target": "q4" } }
          ]
        },
        { "id": "q2", "type": "openText", "headline": { "default": "q2" }, "config": { "inputType": "short" }, "logic": [] },
        { "id": "q3", "type": "openText", "headline": { "default": "q3" }, "config": { "inputType": "short" }, "logic": [] },
        { "id": "q4", "type": "openText", "headline": { "default": "q4" }, "config": { "inputType": "short" }, "logic": [] }
      ],
      "endings": [{ "id": "end1", "type": "endScreen", "headline": { "default": "Done" } }]
    },
    "answers": { "q1": 9 },
    "currentQuestionId": "q1",
    "expected_next": { "type": "question", "id": "q3" }
  },

  {
    "name": "require before jumpTo on same question — require ignored for navigation, jumpTo wins",
    "description": "r1 is require(q3) [non-navigation], r2 is jumpTo q4. nextStep skips r1 and returns q4; q3 is also required.",
    "survey": {
      "languages": [{ "code": "en", "label": "English", "default": true }],
      "questions": [
        {
          "id": "q1",
          "type": "singleSelect",
          "headline": { "default": "Pick" },
          "config": { "choices": [{ "id": "x", "label": { "default": "X" } }, { "id": "y", "label": { "default": "Y" } }] },
          "logic": [
            { "id": "r1", "condition": { "leftQuestionId": "q1", "operator": "equals", "value": "x" }, "action": { "type": "require", "target": "q3" } },
            { "id": "r2", "condition": { "leftQuestionId": "q1", "operator": "equals", "value": "x" }, "action": { "type": "jumpTo", "target": "q4" } }
          ]
        },
        { "id": "q2", "type": "openText", "headline": { "default": "q2" }, "config": { "inputType": "short" }, "logic": [] },
        { "id": "q3", "type": "openText", "headline": { "default": "q3" }, "config": { "inputType": "short" }, "logic": [] },
        { "id": "q4", "type": "openText", "headline": { "default": "q4" }, "config": { "inputType": "short" }, "logic": [] }
      ],
      "endings": [{ "id": "end1", "type": "endScreen", "headline": { "default": "Done" } }]
    },
    "answers": { "q1": "x" },
    "currentQuestionId": "q1",
    "expected_next": { "type": "question", "id": "q4" },
    "expected_required": ["q3"]
  }
]
