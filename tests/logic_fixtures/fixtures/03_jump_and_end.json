[
  {
    "name": "jumpTo — skips an intermediate question",
    "description": "On q1, jumpTo q4 -> q2/q3 are bypassed for this respondent.",
    "survey": {
      "languages": [{ "code": "en", "label": "English", "default": true }],
      "questions": [
        {
          "id": "q1",
          "type": "singleSelect",
          "headline": { "default": "Path?" },
          "config": { "choices": [{ "id": "a", "label": { "default": "A" } }, { "id": "b", "label": { "default": "B" } }] },
          "logic": [
            { "id": "j1", "condition": { "leftQuestionId": "q1", "operator": "equals", "value": "a" }, "action": { "type": "jumpTo", "target": "q4" } }
          ]
        },
        { "id": "q2", "type": "openText", "headline": { "default": "q2" }, "config": { "inputType": "short" }, "logic": [] },
        { "id": "q3", "type": "openText", "headline": { "default": "q3" }, "config": { "inputType": "short" }, "logic": [] },
        { "id": "q4", "type": "openText", "headline": { "default": "q4" }, "config": { "inputType": "short" }, "logic": [] }
      ],
      "endings": [{ "id": "end1", "type": "endScreen", "headline": { "default": "Done" } }]
    },
    "answers": { "q1": "a" },
    "currentQuestionId": "q1",
    "expected_next": { "type": "question", "id": "q4" }
  },

  {
    "name": "jumpTo — directly to an ending id",
    "description": "On q1, jumpTo end_early -> ending screen (target matches an ending id).",
    "survey": {
      "languages": [{ "code": "en", "label": "English", "default": true }],
      "questions": [
        {
          "id": "q1",
          "type": "singleSelect",
          "headline": { "default": "Continue?" },
          "config": { "choices": [{ "id": "yes", "label": { "default": "Yes" } }, { "id": "no", "label": { "default": "No" } }] },
          "logic": [
            { "id": "j1", "condition": { "leftQuestionId": "q1", "operator": "equals", "value": "no" }, "action": { "type": "jumpTo", "target": "end_early" } }
          ]
        },
        { "id": "q2", "type": "openText", "headline": { "default": "q2" }, "config": { "inputType": "short" }, "logic": [] }
      ],
      "endings": [
        { "id": "end_main", "type": "endScreen", "headline": { "default": "Thanks!" } },
        { "id": "end_early", "type": "endScreen", "headline": { "default": "No problem, goodbye." } }
      ]
    },
    "answers": { "q1": "no" },
    "currentQuestionId": "q1",
    "expected_next": { "type": "ending", "id": "end_early" }
  },

  {
    "name": "endSurvey — with explicit endingId",
    "description": "endSurvey action carrying endingId -> that specific ending.",
    "survey": {
      "languages": [{ "code": "en", "label": "English", "default": true }],
      "questions": [
        {
          "id": "q1",
          "type": "consent",
          "headline": { "default": "Do you consent?" },
          "config": { "label": { "default": "I agree" } },
          "logic": [
            { "id": "e1", "condition": { "leftQuestionId": "q1", "operator": "isNotAccepted" }, "action": { "type": "endSurvey", "endingId": "declined" } }
          ]
        },
        { "id": "q2", "type": "openText", "headline": { "default": "q2" }, "config": { "inputType": "short" }, "logic": [] }
      ],
      "endings": [
        { "id": "completed", "type": "endScreen", "headline": { "default": "All done" } },
        { "id": "declined", "type": "endScreen", "headline": { "default": "You declined." } }
      ]
    },
    "answers": { "q1": false },
    "currentQuestionId": "q1",
    "expected_next": { "type": "ending", "id": "declined" }
  },

  {
    "name": "endSurvey — without endingId defaults to first ending",
