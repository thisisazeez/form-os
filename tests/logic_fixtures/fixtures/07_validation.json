[
  {
    "name": "validate — no-backward-jump guard rejects a jumpTo to an earlier question",
    "description": "q3 jumps back to q1 (lower index) -> validateSurvey fails with backward_jump. (Structurally valid JSON; the in-code check catches it.)",
    "survey": {
      "languages": [{ "code": "en", "label": "English", "default": true }],
      "questions": [
        { "id": "q1", "type": "openText", "headline": { "default": "q1" }, "config": { "inputType": "short" }, "logic": [] },
        { "id": "q2", "type": "openText", "headline": { "default": "q2" }, "config": { "inputType": "short" }, "logic": [] },
        {
          "id": "q3",
          "type": "singleSelect",
          "headline": { "default": "q3" },
          "config": { "choices": [{ "id": "a", "label": { "default": "A" } }, { "id": "b", "label": { "default": "B" } }] },
          "logic": [
            { "id": "bad", "condition": { "leftQuestionId": "q3", "operator": "equals", "value": "a" }, "action": { "type": "jumpTo", "target": "q1" } }
          ]
        }
      ],
      "endings": [{ "id": "end1", "type": "endScreen", "headline": { "default": "Done" } }]
    },
    "expectValid": false,
    "expectedErrorCode": "backward_jump"
  },

  {
    "name": "validate — jumpTo to self is a backward jump",
    "description": "A rule on q2 jumping to q2 (same index) is rejected (not strictly later).",
    "survey": {
      "languages": [{ "code": "en", "label": "English", "default": true }],
      "questions": [
        { "id": "q1", "type": "openText", "headline": { "default": "q1" }, "config": { "inputType": "short" }, "logic": [] },
        {
          "id": "q2",
          "type": "number",
          "headline": { "default": "q2" },
          "config": {},
          "logic": [
            { "id": "selfjump", "condition": { "leftQuestionId": "q2", "operator": "greaterThan", "value": 5 }, "action": { "type": "jumpTo", "target": "q2" } }
          ]
        }
      ],
      "endings": [{ "id": "end1", "type": "endScreen", "headline": { "default": "Done" } }]
    },
    "expectValid": false,
    "expectedErrorCode": "backward_jump"
  },

