    },
    "expectValid": false,
    "expectedErrorCode": "forward_condition_ref"
  },

  {
    "name": "validate — valid forward jumpTo and ending target passes",
    "description": "A correct survey (forward jump to q3, then a rule to an ending) -> validateSurvey ok. Sanity 'positive' validation case.",
    "survey": {
      "languages": [{ "code": "en", "label": "English", "default": true }],
      "questions": [
        {
          "id": "q1",
          "type": "number",
          "headline": { "default": "q1" },
          "config": {},
          "logic": [
            { "id": "ok1", "condition": { "leftQuestionId": "q1", "operator": "greaterThan", "value": 5 }, "action": { "type": "jumpTo", "target": "q3" } }
          ]
        },
        { "id": "q2", "type": "openText", "headline": { "default": "q2" }, "config": { "inputType": "short" }, "logic": [] },
        {
          "id": "q3",
          "type": "openText",
          "headline": { "default": "q3" },
          "config": { "inputType": "short" },
          "logic": [
            { "id": "ok2", "condition": { "leftQuestionId": "q3", "operator": "isSubmitted" }, "action": { "type": "jumpTo", "target": "end1" } }
          ]
        }
      ],
      "endings": [{ "id": "end1", "type": "endScreen", "headline": { "default": "Done" } }]
    },
    "expectValid": true
  }
