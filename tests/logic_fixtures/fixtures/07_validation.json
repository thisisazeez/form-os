    "expectedErrorCode": "invalid_operator"
  },

  {
    "name": "validate — condition references a later (forward) question",
    "description": "A rule on q1 conditions on q2 (a later question) -> forward_condition_ref.",
    "survey": {
      "languages": [{ "code": "en", "label": "English", "default": true }],
      "questions": [
        {
          "id": "q1",
          "type": "openText",
          "headline": { "default": "q1" },
          "config": { "inputType": "short" },
          "logic": [
            { "id": "bad", "condition": { "leftQuestionId": "q2", "operator": "isSubmitted" }, "action": { "type": "jumpTo", "target": "q3" } }
          ]
        },
        { "id": "q2", "type": "openText", "headline": { "default": "q2" }, "config": { "inputType": "short" }, "logic": [] },
