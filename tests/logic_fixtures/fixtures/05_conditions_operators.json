  {
    "name": "conditions — AND connector (both true)",
    "description": "Jump only if NPS>=9 AND plan==pro. Both hold -> jump.",
    "survey": {
      "languages": [{ "code": "en", "label": "English", "default": true }],
      "questions": [
        { "id": "plan", "type": "singleSelect", "headline": { "default": "Plan?" }, "config": { "choices": [{ "id": "free", "label": { "default": "Free" } }, { "id": "pro", "label": { "default": "Pro" } }] }, "logic": [] },
        {
          "id": "nps",
          "type": "nps",
          "headline": { "default": "NPS?" },
          "config": {},
          "logic": [
            {
              "id": "r1",
              "condition": {
                "connector": "and",
                "conditions": [
                  { "leftQuestionId": "nps", "operator": "greaterThanOrEqual", "value": 9 },
                  { "leftQuestionId": "plan", "operator": "equals", "value": "pro" }
                ]
              },
              "action": { "type": "jumpTo", "target": "advocate" }
            }
          ]
        },
        { "id": "normal", "type": "openText", "headline": { "default": "normal" }, "config": { "inputType": "short" }, "logic": [] },
        { "id": "advocate", "type": "openText", "headline": { "default": "advocate" }, "config": { "inputType": "short" }, "logic": [] }
      ],
      "endings": [{ "id": "end1", "type": "endScreen", "headline": { "default": "Done" } }]
    },
    "answers": { "plan": "pro", "nps": 10 },
    "currentQuestionId": "nps",
    "expected_next": { "type": "question", "id": "advocate" }
  },

