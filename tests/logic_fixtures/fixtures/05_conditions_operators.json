  {
    "name": "conditions — OR connector (one true)",
    "description": "Jump if NPS<=3 OR churnRisk==yes. churnRisk yes -> jump even though NPS is high.",
    "survey": {
      "languages": [{ "code": "en", "label": "English", "default": true }],
      "questions": [
        { "id": "churnRisk", "type": "singleSelect", "headline": { "default": "At risk?" }, "config": { "choices": [{ "id": "yes", "label": { "default": "Yes" } }, { "id": "no", "label": { "default": "No" } }] }, "logic": [] },
        {
          "id": "nps",
          "type": "nps",
          "headline": { "default": "NPS?" },
          "config": {},
          "logic": [
            {
              "id": "r1",
              "condition": {
                "connector": "or",
                "conditions": [
                  { "leftQuestionId": "nps", "operator": "lessThanOrEqual", "value": 3 },
                  { "leftQuestionId": "churnRisk", "operator": "equals", "value": "yes" }
                ]
              },
              "action": { "type": "jumpTo", "target": "retention" } }
          ]
        },
        { "id": "normal", "type": "openText", "headline": { "default": "normal" }, "config": { "inputType": "short" }, "logic": [] },
        { "id": "retention", "type": "openText", "headline": { "default": "retention" }, "config": { "inputType": "short" }, "logic": [] }
      ],
      "endings": [{ "id": "end1", "type": "endScreen", "headline": { "default": "Done" } }]
    },
    "answers": { "churnRisk": "yes", "nps": 9 },
    "currentQuestionId": "nps",
    "expected_next": { "type": "question", "id": "retention" }
  },

  {
    "name": "conditions — nested AND within OR",
    "description": "Jump if (planActive AND tenureLong) OR vip. planActive AND tenureLong both hold -> jump.",
    "survey": {
      "languages": [{ "code": "en", "label": "English", "default": true }],
      "questions": [
        { "id": "vip", "type": "consent", "headline": { "default": "VIP?" }, "config": { "label": { "default": "VIP" } }, "logic": [] },
        { "id": "tenure", "type": "number", "headline": { "default": "Months?" }, "config": {}, "logic": [] },
        {
          "id": "active",
          "type": "consent",
          "headline": { "default": "Active?" },
          "config": { "label": { "default": "Active" } },
          "logic": [
            {
              "id": "r1",
              "condition": {
                "connector": "or",
                "conditions": [
                  {
                    "connector": "and",
                    "conditions": [
                      { "leftQuestionId": "active", "operator": "isAccepted" },
                      { "leftQuestionId": "tenure", "operator": "greaterThan", "value": 12 }
                    ]
                  },
                  { "leftQuestionId": "vip", "operator": "isAccepted" }
                ]
              },
              "action": { "type": "jumpTo", "target": "loyal" }
            }
          ]
        },
        { "id": "standard", "type": "openText", "headline": { "default": "standard" }, "config": { "inputType": "short" }, "logic": [] },
        { "id": "loyal", "type": "openText", "headline": { "default": "loyal" }, "config": { "inputType": "short" }, "logic": [] }
      ],
      "endings": [{ "id": "end1", "type": "endScreen", "headline": { "default": "Done" } }]
    },
    "answers": { "vip": false, "tenure": 24, "active": true },
    "currentQuestionId": "active",
    "expected_next": { "type": "question", "id": "loyal" }
  },

