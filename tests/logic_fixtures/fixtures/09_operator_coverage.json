[
  {
    "name": "operators — date after (true)",
    "description": "FU-2 coverage: `after` on a date answer. dob 2010-05-01 is after 2000-01-01 -> rule fires -> jumpTo younger.",
    "survey": {
      "languages": [{ "code": "en", "label": "English", "default": true }],
      "questions": [
        {
          "id": "dob",
          "type": "date",
          "headline": { "default": "Date of birth" },
          "config": { "format": "YYYY-MM-DD" },
          "logic": [
            { "id": "r1", "condition": { "leftQuestionId": "dob", "operator": "after", "value": "2000-01-01" }, "action": { "type": "jumpTo", "target": "younger" } }
          ]
        },
        { "id": "older", "type": "openText", "headline": { "default": "older" }, "config": { "inputType": "short" }, "logic": [] },
        { "id": "younger", "type": "openText", "headline": { "default": "younger" }, "config": { "inputType": "short" }, "logic": [] }
      ],
      "endings": [{ "id": "end1", "type": "endScreen", "headline": { "default": "Done" } }]
    },
    "answers": { "dob": "2010-05-01" },
    "currentQuestionId": "dob",
    "expected_next": { "type": "question", "id": "younger" }
  },

