  {
    "name": "operators — multiSelect includesOnly set-equal (true)",
    "description": "FU-2 coverage: `includesOnly` (multi-select set-equality). Selected {a,b} EXACTLY equals target {a,b} -> true -> jumpTo exact.",
    "survey": {
      "languages": [{ "code": "en", "label": "English", "default": true }],
      "questions": [
        {
          "id": "feat",
          "type": "multiSelect",
          "headline": { "default": "Which features?" },
          "config": { "choices": [{ "id": "a", "label": { "default": "A" } }, { "id": "b", "label": { "default": "B" } }, { "id": "c", "label": { "default": "C" } }] },
          "logic": [
            { "id": "r1", "condition": { "leftQuestionId": "feat", "operator": "includesOnly", "value": ["a", "b"] }, "action": { "type": "jumpTo", "target": "exact" } }
          ]
        },
        { "id": "other", "type": "openText", "headline": { "default": "other" }, "config": { "inputType": "short" }, "logic": [] },
        { "id": "exact", "type": "openText", "headline": { "default": "exact" }, "config": { "inputType": "short" }, "logic": [] }
      ],
      "endings": [{ "id": "end1", "type": "endScreen", "headline": { "default": "Done" } }]
    },
    "answers": { "feat": ["a", "b"] },
    "currentQuestionId": "feat",
    "expected_next": { "type": "question", "id": "exact" }
  },

  {
    "name": "operators — multiSelect includesOnly superset (false -> linear, discriminates from includesAll)",
    "description": "FU-2 coverage: the DISCRIMINATING `includesOnly` case. Selected {a,b,c} CONTAINS target {a,b} but is not EQUAL to it -> includesOnly is FALSE (whereas includesAll would be TRUE here) -> no nav rule matches -> linear next 'other'. This is what makes includesOnly materially distinct from includesAll.",
    "survey": {
      "languages": [{ "code": "en", "label": "English", "default": true }],
      "questions": [
        {
          "id": "feat",
          "type": "multiSelect",
          "headline": { "default": "Which features?" },
          "config": { "choices": [{ "id": "a", "label": { "default": "A" } }, { "id": "b", "label": { "default": "B" } }, { "id": "c", "label": { "default": "C" } }] },
          "logic": [
            { "id": "r1", "condition": { "leftQuestionId": "feat", "operator": "includesOnly", "value": ["a", "b"] }, "action": { "type": "jumpTo", "target": "exact" } }
          ]
        },
        { "id": "other", "type": "openText", "headline": { "default": "other" }, "config": { "inputType": "short" }, "logic": [] },
        { "id": "exact", "type": "openText", "headline": { "default": "exact" }, "config": { "inputType": "short" }, "logic": [] }
      ],
      "endings": [{ "id": "end1", "type": "endScreen", "headline": { "default": "Done" } }]
    },
    "answers": { "feat": ["a", "b", "c"] },
    "currentQuestionId": "feat",
    "expected_next": { "type": "question", "id": "other" }
  },

