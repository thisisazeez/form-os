# ============================================================================
# onForm — example environment configuration.
# Copy to `.env` for local dev:  cp .env.example .env
# `.env` is gitignored. NEVER commit real secrets (see contracts/REVIEW.md §3.6).
# Settings are read via django-environ in config/settings/base.py.
# ============================================================================

# --- Core ---
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=dev-insecure-change-me-please-use-a-real-secret-in-prod
DEBUG=True
# Comma-separated. django-tenants needs the base host here.
ALLOWED_HOSTS=localhost,127.0.0.1,.localhost

# --- Database (PostgreSQL — REQUIRED; django-tenants does not support SQLite) ---
# Matches the docker-compose.yml service. The ENGINE is forced to the
# django-tenants Postgres backend in settings; only the connection params come from here.
DATABASE_URL=postgres://onform:onform@localhost:5432/onform

# --- Tenant routing (ADR-001 path-based) ---
# The shared base domain all orgs are served under. A single Domain row points here.
BASE_DOMAIN=localhost

# --- Redis / Celery (PLAN §13) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Vite island pipeline (django-vite, PLAN §8) ---
# In dev, django-vite proxies to the Vite dev server when DJANGO_VITE_DEV_MODE=True.
# For the Phase-0 smoke test we default to manifest mode (False) so a built bundle is used;
# flip to True and run `npm run dev` in ./frontend for HMR.
DJANGO_VITE_DEV_MODE=False
DJANGO_VITE_DEV_SERVER_PORT=5173

# --- Email (Phase 1; console backend in dev) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@onform.example.com
